@custom-media --desktop (min-width: 1200px);
@custom-media --first-breakpoint (max-width: 1200px);
@custom-media --second-breakpoint (max-width: 960px);
@custom-media --tablet (max-width: 1200px) and (min-width: 800px);
@custom-media --mobile (max-width: 800px);
@custom-media --small-width (max-width: 480px);
