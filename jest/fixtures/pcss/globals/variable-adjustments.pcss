/**
 * Any adjustments to the CSS variables based on media queries
 * must be done in a separate file to avoid duplication in the
 * output of every js based .pcss file.
 *
 */
:root {
	@media (--first-breakpoint ) {
		--content-width: 1200px;
	}

	@media (--second-breakpoint ) {
		--content-width: 800px;
	}
}
