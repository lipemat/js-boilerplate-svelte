@import './globals/media-queries.pcss';
@import './globals/variables.pcss';
@import './globals/variable-adjustments.pcss';

.share {
	font-weight: 700;

	a {
		background: transparent;
		border-bottom: 1px solid var(--c-yellow);
		border-right: 2px solid var(--c-black);
		padding: 15px;
	}
}

.global-class-name {
	background: #9acd32;
}

.parent-class-name {
	.child-class-name {
		background: var(--c-yellow);
	}
}
